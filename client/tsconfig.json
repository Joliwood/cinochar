{
  "compilerOptions": {
    "resolveJsonModule": true,
    "outDir": "./.next/",
    "noImplicitAny": false,
    "module": "ESNext",
    "target": "es5",
    "jsx": "preserve",
    "allowJs": true,
    "moduleResolution": "node",
    "noEmitOnError": true,
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "#types": [
        "./types/"
      ],
      "#utils": [
        "./utils"
      ],
      "#components": [
        "./components"
      ],
      "#store": [
        "./store"
      ],
    },
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "incremental": true,
    "esModuleInterop": true,
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.js",
    "**/*.tsx",
    ".eslintrc.js",
    "tailwind.config.cjs",
  ],
  "exclude": [
    "node_modules",
    "next"
  ]
}
