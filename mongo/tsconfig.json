{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "esModuleInterop": true,
    "module": "CommonJS",
    "noEmit": true,
    "outDir": "./dist",
    "rootDir": ".",
  },
  "include": [
    "./*",
    "./**/*",
    "./index.ts",
    "./types/*",
    ".eslintrc.cjs",
    "/**/*.ts",
  ],
  "exclude": [
    "./dist/**/*",
    "./node_modules",
  ]
}
