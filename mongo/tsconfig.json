{
  "compilerOptions": {
    "allowJs": true,
    "composite": true,
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "Node",
    "noEmit": false,
    "outDir": "./dist",
    "resolveJsonModule": true,
    "rootDir": ".",
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "noImplicitAny": true,
  },
  "include": [
    "./*",
    "./**/*",
    "./types/*",
    ".eslintrc.cjs",
    "/**/*.ts",
    "index.ts",
  ],
  "exclude": [
    "./dist/**/*",
    "node_modules",
  ]
}