{
  "name": "cinochar",
  "version": "1.0.0",
  "private": true,
  "repository": "git@github.com:Joliwood/cinochar.git",
  "author": "Guillaume <jolibois.contact@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev:client": "yarn workspace client dev:client",
    "dev:websocket": "yarn workspace websocket dev:websocket",
    "dev:mongo": "yarn workspace mongo dev:mongo",
    "dev": "concurrently \"yarn start-server\" \"yarn start-client\"",
    "eslint": "concurrently \"yarn workspace client eslint\" \"yarn workspace server eslint\"",
    "typescript": "concurrently \"yarn workspace client typescript\" \"yarn workspace server typescript\"",
    "check:full": "yarn eslint && yarn typescript"
  },
  "workspaces": [
    "client",
    "websocket",
    "mongo"
  ],
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
